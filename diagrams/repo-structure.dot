// Pulsar repository and folder structure (parent repo and six submodules).
digraph repo {
  rankdir=LR;
  fontname="Helvetica"; fontsize=12;
  node [fontname="Helvetica", fontsize=11, shape=plain];
  edge [color="#5A6B7B", arrowsize=0.7];

  root [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="#FFF3C4" color="#5A6B7B">
      <tr><td><b>pulsar-firmware</b>  (parent repo)</td></tr>
      <tr><td align="left">CMakeLists.txt<br align="left"/>CMakePresets.json<br align="left"/>cmake/gcc-arm-none-eabi.cmake<br align="left"/>scripts/build.sh<br align="left"/>docs/<br align="left"/>README.md, .gitignore, .gitmodules<br align="left"/></td></tr>
    </table>>];

  cubemx [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="#E3F0E6" color="#7FA88A">
      <tr><td><b>cubemx/</b>  pulsar-cubemx</td></tr>
      <tr><td align="left">stm_display.ioc<br align="left"/>Core/ (Inc, Src)<br align="left"/>Drivers/ (HAL, CMSIS)<br align="left"/>Middlewares/ (FreeRTOS, USB)<br align="left"/>USB_HOST/<br align="left"/>cmake/stm32cubemx/<br align="left"/>startup, linker script<br align="left"/></td></tr>
      <tr><td><i>generated by CubeMX</i></td></tr>
    </table>>];

  touchgfx [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="#E3F0E6" color="#7FA88A">
      <tr><td><b>touchgfx/</b>  pulsar-touchgfx</td></tr>
      <tr><td align="left">*.touchgfx project<br align="left"/>assets/<br align="left"/>gui/ (ours)<br align="left"/>generated/ (Designer)<br align="left"/></td></tr>
      <tr><td><i>generated by TouchGFX Designer</i></td></tr>
    </table>>];

  app [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="#DCEBFA" color="#6C8FB5">
      <tr><td><b>app/</b>  pulsar-app</td></tr>
      <tr><td align="left">app.hpp, app.cpp<br align="left"/>(later: gyro, button, led,<br align="left"/>logging, USB protocol)<br align="left"/></td></tr>
      <tr><td><i>hand-written C++20</i></td></tr>
    </table>>];

  pctool [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="#F4EEF8" color="#9A82B0">
      <tr><td><b>pc-tool/</b>  pulsar-pc-tool</td></tr>
      <tr><td align="left">live plot<br align="left"/>CSV logging<br align="left"/>commands<br align="left"/></td></tr>
      <tr><td><i>not part of the firmware build</i></td></tr>
    </table>>];

  uiux [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="#FCE4EC" color="#C08497">
      <tr><td><b>ui-ux/</b>  pulsar-ui-ux</td></tr>
      <tr><td align="left">flows/<br align="left"/>screens/<br align="left"/>assets/<br align="left"/>fonts/<br align="left"/>startup/<br align="left"/></td></tr>
      <tr><td><i>Figma exports, not compiled;<br/>assets are copied into touchgfx/assets</i></td></tr>
    </table>>];

  design [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="#FDEBD0" color="#C99A5B">
      <tr><td><b>design/</b>  pulsar-design</td></tr>
      <tr><td align="left">Doxyfile<br align="left"/>hld/ (pages, module groups)<br align="left"/>lld/ (module design)<br align="left"/>diagrams/ (this diagram)<br align="left"/></td></tr>
      <tr><td><i>Doxygen design, not compiled;<br/>Doxygen also reads ../app</i></td></tr>
    </table>>];

  root -> cubemx;
  root -> touchgfx;
  root -> app;
  root -> pctool;
  root -> uiux;
  root -> design;

}
