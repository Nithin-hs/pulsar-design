// Pulsar product block diagram: people, on-board hardware, firmware layers, PC tool.
// Used by Doxygen (\dotfile) and exported to product.svg.
digraph product {
  rankdir=TB;
  nodesep=0.35; ranksep=0.55;
  fontname="Helvetica"; fontsize=12; labelloc=t;
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#5A6B7B"];
  edge [fontname="Helvetica", fontsize=9, color="#5A6B7B", arrowsize=0.7];

  // outside the device
  user [label="User", shape=ellipse, fillcolor="#FFF3C4"];
  pc   [label="PC tool\nlive plot, CSV logging, commands", fillcolor="#F4EEF8", color="#9A82B0"];

  subgraph cluster_device {
    label="Pulsar device  (STM32F429I-DISC1, STM32F429ZIT6, Cortex-M4F)";
    style="rounded,filled"; fillcolor="#F4F7FA"; color="#5A6B7B";

    subgraph cluster_hw {
      label="On-board hardware"; style="rounded,filled"; fillcolor="#E8EEF4"; color="#8A9BAB";
      btn  [label="User button B1\n(PA0)"];
      lcd  [label="2.4\" TFT 240x320\n(8 MB SDRAM frame buffer)"];
      gyro [label="Gyroscope"];
      leds [label="LEDs LD3, LD4"];
      usb  [label="USB OTG micro-AB"];
    }

    subgraph cluster_fw {
      label="Firmware  (C++20, FreeRTOS)"; style="rounded,filled"; fillcolor="#E3F0E6"; color="#7FA88A";
      hal    [label="HAL and drivers (CubeMX generated)\nclock 180 MHz, GPIO, SPI5, LTDC, FMC, USB", fillcolor="#DDE9DF"];
      input  [label="Button input\nshort press: next\nlong press: select"];
      sensor [label="Sensor service\ngyro sampling"];
      ui     [label="Display UI (TouchGFX)\nstartup image, menu,\nLive Data, Device info"];
      comm   [label="USB CDC and protocol\nstream and commands"];
      app    [label="Application core\nmenu logic, state", fillcolor="#FFF8E1"];
      log    [label="Logging", fillcolor="#F1F1F1"];
      {rank=same; input; sensor; ui; comm}
    }
  }

  // people and PC
  user -> btn [label="presses"];
  user -> lcd [dir=back, label="sees"];
  pc   -> usb [dir=both, label="USB cable"];

  // hardware to HAL
  btn  -> hal [dir=both, label="GPIO"];
  gyro -> hal [dir=both, label="SPI5"];
  lcd  -> hal [dir=both, label="LTDC, FMC"];
  leds -> hal [dir=both, label="GPIO"];
  usb  -> hal [dir=both, label="USB OTG"];

  // HAL to services
  hal -> input;
  hal -> sensor;
  hal -> ui;
  hal -> comm;

  // services to application core
  input  -> app;
  sensor -> app;
  app    -> ui;
  app    -> comm;
  sensor -> comm [label="stream"];

  log -> app [style=dashed, arrowhead=none, label="used by all modules"];

  {rank=same; user; pc}
}
